---
// Sim page control bar: one quiet capsule of monoline glyphs in three
// groups split by hairlines — ? (undo · redo on phones) | pause · reset · fullscreen | dice · ⚙.
// Hover (fine pointers) lifts a glyph and shows its label above the capsule
// with an accent tick. The dice and ? are hidden until a sim's setup wires
// them (lib/sim-page/control-bar.ts). Play/pause, fullscreen and ⚙/× swap
// glyphs through the `paused`, `fs` and `open` classes, never through text.
// The sprite below is shared with the ? reference card.
interface Props {
  simId: string;
}
const { simId } = Astro.props;
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="ci-pause" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"/></symbol>
  <symbol id="ci-play" viewBox="0 0 24 24"><path d="M7 4.5v15l12-7.5z"/></symbol>
  <symbol id="ci-reset" viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v5h5"/></symbol>
  <symbol id="ci-full" viewBox="0 0 24 24"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></symbol>
  <symbol id="ci-full-exit" viewBox="0 0 24 24"><path d="M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5"/></symbol>
  <symbol id="ci-dice" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="8.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none"/><circle cx="8.5" cy="15.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15.5" r="1.1" fill="currentColor" stroke="none"/></symbol>
  <symbol id="ci-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5"/><circle cx="12" cy="17" r=".7" fill="currentColor" stroke="none"/></symbol>
  <symbol id="ci-sliders" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></symbol>
  <symbol id="ci-undo" viewBox="0 0 24 24"><path d="M9 6 4.5 10.5 9 15"/><path d="M5 10.5h9.5a5 5 0 0 1 0 10H12"/></symbol>
  <symbol id="ci-redo" viewBox="0 0 24 24"><path d="m15 6 4.5 4.5L15 15"/><path d="M19 10.5H9.5a5 5 0 0 0 0 10H12"/></symbol>
  <symbol id="ci-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="hp-point" viewBox="0 0 24 24"><path d="M10 11V4.5a1.5 1.5 0 0 1 3 0V12"/><path d="M13 11.5a1.5 1.5 0 0 1 3 .5v1.5M16 13a1.5 1.5 0 0 1 3 .5V16a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L4.6 15.8a1.4 1.4 0 0 1 2.2-1.7L10 17"/></symbol>
  <symbol id="hp-pinch" viewBox="0 0 24 24"><path d="M4 4l6 6M4 4v5M4 4h5M20 20l-6-6M20 20v-5M20 20h-5"/></symbol>
  <symbol id="hp-touch" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none"/></symbol>
  <symbol id="hp-hover" viewBox="0 0 24 24"><path d="M6 4l12 8-5 1.5L10 19z"/></symbol>
  <symbol id="hp-wheel" viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="5"/><path d="M12 7v3"/></symbol>
  <symbol id="hp-move" viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3"/></symbol>
  <symbol id="hp-map" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><rect x="9" y="9" width="6" height="6"/></symbol>
  <symbol id="hp-lr" viewBox="0 0 24 24"><path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4"/></symbol>
  <symbol id="hp-cursor" viewBox="0 0 24 24"><path d="M12 4v16M9 4h6M9 20h6"/></symbol>
  <symbol id="hp-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></symbol>
  <symbol id="hp-key" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h.01M11 10h.01M15 10h.01M8 14h8"/></symbol>
  <symbol id="hp-tilt" viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2" transform="rotate(-12 12 12)"/><path d="M12 18.5h.01"/></symbol>
</svg>

<div class="controls" id={`controls-${simId}`}>
  <div class="ctrl-group" hidden>
    <button class="ctrl-btn subtle" data-action="help" data-label="controls" aria-label="Controls" hidden>
      <svg class="ctrl-icon"><use href="#ci-help"/></svg>
    </button>
    <button class="ctrl-btn" data-action="undo" data-label="undo" aria-label="Undo" hidden>
      <svg class="ctrl-icon"><use href="#ci-undo"/></svg>
    </button>
    <button class="ctrl-btn" data-action="redo" data-label="redo" aria-label="Redo" hidden>
      <svg class="ctrl-icon"><use href="#ci-redo"/></svg>
    </button>
  </div>
  <div class="ctrl-group">
    <button class="ctrl-btn" data-action="play-pause" data-label="pause" aria-label="Pause">
      <svg class="ctrl-icon when-playing"><use href="#ci-pause"/></svg>
      <svg class="ctrl-icon when-paused"><use href="#ci-play"/></svg>
    </button>
    <button class="ctrl-btn" data-action="reset" data-label="reset" aria-label="Reset">
      <svg class="ctrl-icon"><use href="#ci-reset"/></svg>
    </button>
    <button class="ctrl-btn" data-action="fullscreen" data-label="fullscreen" aria-label="Fullscreen">
      <svg class="ctrl-icon when-windowed"><use href="#ci-full"/></svg>
      <svg class="ctrl-icon when-fs"><use href="#ci-full-exit"/></svg>
    </button>
  </div>
  <div class="ctrl-group">
    <button class="ctrl-btn" data-action="randomize" data-label="randomize" aria-label="Randomize" hidden>
      <svg class="ctrl-icon"><use href="#ci-dice"/></svg>
    </button>
    <button class="ctrl-btn" data-action="settings" data-label="parameters" aria-label="Parameters">
      <svg class="ctrl-icon when-closed"><use href="#ci-sliders"/></svg>
      <svg class="ctrl-icon when-open"><use href="#ci-close"/></svg>
    </button>
  </div>
</div>

<style>
  .controls {
    position: absolute;
    bottom: 0.9rem;
    right: 1rem;
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 4px;
    border-radius: 999px;
    background: rgba(8, 6, 4, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 10;
  }

  .ctrl-group {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 4px;
  }
  .ctrl-group[hidden] { display: none; }
  .ctrl-group + .ctrl-group { border-left: 1px solid rgba(255, 255, 255, 0.1); }

  .ctrl-btn {
    position: relative;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-primary);
    opacity: 0.6;
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: 50%;
    transition: opacity var(--transition-speed), color var(--transition-speed);
    -webkit-tap-highlight-color: transparent;
  }
  .ctrl-btn[hidden] { display: none; }
  /* undo / redo live here on phones only; the desktop panel header keeps its own */
  @media (min-width: 769px) { .ctrl-btn[data-action="undo"], .ctrl-btn[data-action="redo"] { display: none; } }
  .ctrl-btn.subtle { opacity: 0.4; }
  .ctrl-btn:focus-visible, .ctrl-btn.active, .ctrl-btn.open { opacity: 1; }
  /* hover only where it is real: on touch the last tapped button keeps :hover
     until the next tap elsewhere, which held a disabled redo at full brightness */
  @media (hover: hover) { .ctrl-btn:hover { opacity: 1; } }
  .ctrl-btn:focus-visible { outline: 1px solid var(--accent); outline-offset: -1px; }
  .ctrl-btn.active, .ctrl-btn.open { color: var(--accent); }

  .ctrl-icon {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .ctrl-btn .when-paused, .ctrl-btn .when-open, .ctrl-btn .when-fs { display: none; }
  .ctrl-btn.paused .when-playing, .ctrl-btn.open .when-closed, .ctrl-btn.fs .when-windowed { display: none; }
  .ctrl-btn.paused .when-paused, .ctrl-btn.open .when-open, .ctrl-btn.fs .when-fs { display: block; }

  /* Hover label above the capsule and an accent tick under the glyph — on
     hover only, so a pinned (active) glyph never stacks a second label. */
  .ctrl-btn::before, .ctrl-btn::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .ctrl-btn::before {
    content: attr(data-label);
    bottom: calc(100% + 9px);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text-primary);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    transform: translate(-50%, 3px);
  }
  .ctrl-btn::after {
    bottom: 1px;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .ctrl-btn:hover::before { opacity: 1; transform: translate(-50%, 0); }
    .ctrl-btn:hover::after { opacity: 1; }
  }

  /* after every opacity rule above and below: a disabled glyph is always dim */
  @media (max-width: 768px) {
    .controls {
      bottom: 0.5rem;
      right: 0.5rem;
      height: 40px;
      background: rgba(8, 6, 4, 0.5);
    }
    .ctrl-btn { width: 36px; height: 36px; opacity: 0.8; }
    .ctrl-btn.subtle { opacity: 0.55; }
    .ctrl-icon { width: 19px; height: 19px; }
  }
  .ctrl-btn:disabled, .ctrl-btn:disabled:hover { opacity: 0.25; cursor: default; }
</style>
