---
// Everything a search engine or link-preview scraper reads from <head>:
// description, canonical URL, favicons + manifest, Open Graph, Twitter card,
// and (home page) JSON-LD describing Sina as a Person.
// Images are rendered with /admin/og and live in public/ (og/*.png, favicon*).
import { existsSync } from 'node:fs';
import { siteConfig } from '../config';

interface Props {
  /** Full <title> text. */
  title: string;
  description: string;
  /** Share image under public/, e.g. "og/gallery-cppn.png". Falls back to the home image if missing. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'profile' | 'article';
  /** Keep the page out of search results (admin pages). */
  noindex?: boolean;
  /** Emit the Person JSON-LD (home page). */
  person?: boolean;
}

const { title, description, imageAlt, type = 'website', noindex = false, person = false } = Astro.props;
const site = Astro.site ?? new URL('https://heysoos.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const imagePath = Astro.props.image && existsSync(`public/${Astro.props.image}`) ? Astro.props.image : 'og/home.png';
const image = new URL(imagePath, site).href;
const alt = imageAlt ?? `${title}: generative simulation art`;
const twitterHandle = siteConfig.socialLinks.twitter
  ? '@' + siteConfig.socialLinks.twitter.replace(/\/$/, '').split('/').pop()
  : undefined;

const personLd = person && {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  url: site.href,
  image,
  description: siteConfig.description,
  knowsAbout: ['Computational neuroscience', 'Artificial life', 'Physics', 'Generative art', 'WebGPU'],
  sameAs: Object.values(siteConfig.socialLinks).filter(Boolean),
};
---

<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content={siteConfig.name} />
<meta name="theme-color" content="#0a0804" />
<meta name="color-scheme" content="dark light" />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />

<meta name="twitter:card" content="summary_large_image" />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={alt} />

{personLd && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
